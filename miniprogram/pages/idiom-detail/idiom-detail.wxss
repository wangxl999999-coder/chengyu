.report-btn {
  position: fixed;
  top: 30rpx;
  left: 30rpx;
  z-index: 100;
  display: flex;
  align-items: center;
  background: rgba(0, 0, 0, 0.6);
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #fff;
}

.report-icon {
  margin-right: 8rpx;
}

.idiom-header {
  margin-top: 80rpx;
  text-align: center;
  padding: 60rpx;
}

.idiom-text {
  font-size: 56rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.idiom-pinyin {
  font-size: 32rpx;
  color: #666;
}

.idiom-content {
  margin-top: 30rpx;
}

.section {
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #ff6b6b;
  margin-bottom: 20rpx;
}

.section-content {
  font-size: 28rpx;
  color: #333;
  line-height: 52rpx;
}

.action-buttons {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 20rpx 30rpx 40rpx;
  display: flex;
  justify-content: space-between;
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.action-buttons button {
  width: 48%;
  margin: 0;
  padding: 0;
  line-height: 88rpx;
  height: 88rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.btn-icon {
  margin-right: 12rpx;
}

.report-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
}

.report-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
}

.report-content {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 80%;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
}

.report-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.report-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.report-close {
  font-size: 48rpx;
  color: #999;
  line-height: 1;
}

.report-body {
  padding: 30rpx;
}

.report-info {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.report-input {
  width: 100%;
  height: 200rpx;
  padding: 20rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.report-footer {
  display: flex;
  border-top: 1rpx solid #f0f0f0;
}

.report-footer button {
  flex: 1;
  margin: 0;
  padding: 0;
  line-height: 88rpx;
  height: 88rpx;
  border-radius: 0;
  border: none;
  background: #fff;
  font-size: 30rpx;
}

.btn-cancel {
  color: #999;
  border-right: 1rpx solid #f0f0f0 !important;
}

.btn-submit {
  color: #ff6b6b;
  font-weight: bold;
}
